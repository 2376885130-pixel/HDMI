    "duration": 11.838375,
    "cues": [
      {
        "text": "玉兔二号是嫦娥四号任务的月球车。",
        "start_frame": 0,
        "end_frame": 181272
      },
      {
        "text": "它在月球背面开展巡视探测。",
        "start_frame": 188952,
