[
  {
    "id": 0,
    "theme": 1,
    "index": 1,
    "name": "T1P01",
    "source": "D:\\figurefpga\\主题1\\01｜月面探索的先锋.png",
    "source_sha256": "981c7f58d1803f96a39f56e9ad8d99a1af944d1452e91502efb855e382d92c64",
    "original_size": [
      876,
      506
    ],
    "width": 876,
    "height": 506,
    "duration": 13.0245,
    "cues": [
      {
        "text": "月球车是探索月面环境的移动平台。",
        "start_frame": 0,
        "end_frame": 187530
      },
      {
        "text": "它携带相机和科学仪器，观察周围地形。",
        "start_frame": 195210,
        "end_frame": 411474
      },
      {
        "text": "车轮与悬架帮助它缓慢越过不平的月面。",
        "start_frame": 419154,
        "end_frame": 617496
      }
    ]
  },
  {
    "id": 1,
    "theme": 1,
    "index": 2,
    "name": "T1P02",
    "source": "D:\\figurefpga\\主题1\\02｜月球探测器的核心结构.png",
    "source_sha256": "77ce3944d8ad6977035f9085b51a2ed836cc6205f84e2eae15838b1ff0e4c749",
    "original_size": [
      659,
      525
    ],
    "width": 659,
    "height": 525,
    "duration": 14.44975,
    "cues": [
      {
        "text": "月球车由车体、车轮、相机和太阳能板组成。",
        "start_frame": 0,
        "end_frame": 255276
      },
      {
        "text": "车体保护电子设备，悬架连接车轮。",
        "start_frame": 262956,
        "end_frame": 462390
      },
      {
        "text": "各个部分协同工作，完成移动与探测任务。",
        "start_frame": 470070,
        "end_frame": 685908
      }
    ]
  },
  {
    "id": 2,
    "theme": 1,
    "index": 3,
    "name": "T1P03",
    "source": "D:\\figurefpga\\主题1\\03｜太阳能板如何提供能源.png",
