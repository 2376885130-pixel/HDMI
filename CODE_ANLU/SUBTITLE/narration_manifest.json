    "duration": 12.970125,
    "cues": [
      {
        "text": "空间望远镜在地球大气层之外开展观测。",
        "start_frame": 0,
        "end_frame": 204174
      },
      {
        "text": "它能避开部分大气扰动和吸收的影响。",
        "start_frame": 211854,
