    "height": 691,
    "duration": 12.48025,
    "cues": [
      {
        "text": "太阳能板将阳光转化为电能。",
        "start_frame": 0,
        "end_frame": 155388
      },
      {
        "text": "受光方向会影响太阳能板获得的能量。",
        "start_frame": 163068,
        "end_frame": 354912
      },
      {
        "text": "电池储存部分电能，为设备运行提供支持。",
        "start_frame": 362592,
        "end_frame": 591372
      }
    ]
  },
  {
