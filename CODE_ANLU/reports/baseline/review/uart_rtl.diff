+  else if(pending[1])begin choice=1;incoming={3'd1,theme_payload};end
+  else if(pending[2])begin choice=2;incoming={3'd2,image_payload};end
+  else if(pending[3])begin choice=3;incoming={3'd3,4'd0,demo_payload};end
+ end
